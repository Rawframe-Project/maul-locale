<ldml>
	<identity>
		<version number="$Revision$"/>
		<language type="xx"/>
		<territory type="YY"/>
	</identity>
	<localeDisplayNames>
		<languages>
			<language type="en">∅∅∅</language>
		</languages>
	</localeDisplayNames>
	<characters>
		<exemplarCharacters>[a b]</exemplarCharacters>
		<exemplarCharacters type="index" draft="unconfirmed">[Q]</exemplarCharacters>
	</characters>
	<dates>
		<calendars>
			<calendar type="gregorian">
				<months>
					<monthContext type="format">
						<monthWidth type="abbreviated">
							<month type="1" draft="contributed">Jan.</month>
							<month type="2" draft="provisional">Feb.</month>
						</monthWidth>
					</monthContext>
					<monthContext type="stand-alone">
						<monthWidth type="abbreviated">
							<month type="1">↑↑↑</month>
						</monthWidth>
					</monthContext>
				</months>
			</calendar>
		</calendars>
	</dates>
	<numbers>
		<symbols numberSystem="latn">
			<decimal>↑↑↑</decimal>
			<group draft="unconfirmed">'</group>
		</symbols>
	</numbers>
</ldml>
